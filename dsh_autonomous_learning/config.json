{
  "paths": {
    "home": "",
    "data_dir": "",
    "corpus_dir": ""
  },
  "embedding": {
    "provider": "sentence_transformers",
    "dim": 384,
    "model": "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"
  },
  "model": {
    "provider": "mock",
    "base_url": "",
    "api_key_env": "DSH_AL_MODEL_API_KEY",
    "model": "mock-1",
    "timeout_s": 60,
    "max_retries": 2,
    "rate_limit_per_min": 60,
    "max_tokens": 2048,
    "temperature": 0.2,
    "max_cost_usd": 0.5,
    "price_input_per_1k": 0.0,
    "price_output_per_1k": 0.0,
    "stages": {}
  },
  "learning": {
    "default_mode": "assisted",
    "max_iterations_per_run": 10,
    "max_tasks_per_run": 30,
    "max_sources_per_task": 20,
    "max_retries_per_task": 3,
    "max_llm_calls_per_run": 200,
    "max_task_seconds": 300,
    "max_run_seconds": 3600,
    "stop_when_no_new_knowledge": true,
    "no_progress_rounds": 3,
    "stop_when_budget_exceeded": true,
    "require_source_tracking": true,
    "require_verification_status": true,
    "auto_execute_untrusted_code": false,
    "auto_install_dependencies": false,
    "auto_modify_other_plugins": false,
    "daily_budget_usd": 1.0,
    "max_doc_chars": 400000,
    "chunk_size": 900,
    "chunk_overlap": 120,
    "min_chunk_chars": 40,
    "max_chunks_per_document": 400
  },
  "security": {
    "allowed_roots": [],
    "allow_network": false,
    "allowed_domains": [],
    "max_download_bytes": 8388608,
    "max_output_bytes": 65536,
    "exec_timeout_s": 10,
    "exec_memory_mb": 512,
    "audit_log": true,
    "block_secret_patterns": true
  },
  "retrieval": {
    "top_k": 8,
    "min_score": 0.0,
    "hybrid": true,
    "vector_weight": 0.65,
    "keyword_weight": 0.35,
    "rrf_k": 60,
    "dedupe_similarity": 0.94,
    "conflict_similarity": 0.82
  },
  "scheduler": {
    "enabled": false,
    "tick_interval_s": 300,
    "max_parallel_projects": 1,
    "auto_start": false
  },
  "logging": {
    "level": "INFO",
    "jsonl": true,
    "file": ""
  }
}